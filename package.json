{
  "name": "streamvault-cash",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "StreamVault.cash - non-custodial PUSD streaming payroll & subscription vault on Bitcoin Cash",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "compile": "cashc contracts/StreamVault.cash -o contracts/artifacts/StreamVault.json",
    "typecheck": "tsc --noEmit",
    "test": "node contracts/test-streamvault.mjs",
    "test:engine": "node tests/run-engine.mjs",
    "test:agent": "node tests/run-agent.mjs",
    "test:api": "node tests/run-agent-server.mjs",
    "test:derive": "node tests/run-derive.mjs",
    "test:chain": "node tests/run-chain.mjs",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:engine && npm run test:agent && npm run test:api && npm run test:derive && npm run test:chain",
    "verify:client-secrets": "node scripts/check-client-secrets.mjs .env.agent-wallet.local",
    "verify:wallet-config": "node scripts/check-wallet-env.mjs .env.agent-wallet.local",
    "verify:release": "npm run test:all && npm run typecheck && npm run build && npm run verify:client-secrets",
    "verify:network": "node tests/run-network.mjs",
    "settle": "node scripts/settle.mjs",
    "deploy": "vercel --prod"
  },
  "dependencies": {
    "@bitauth/libauth": "^3.1.0-next.8",
    "@wizardconnect/core": "^0.2.4",
    "@wizardconnect/dapp": "^0.2.2",
    "@wizardconnect/react": "^0.2.3",
    "cashscript": "^0.14.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "cashc": "^0.14.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
