pragma cashscript ^0.10.0;

/**
 * @title AgentVault
 * @notice Non-custodial AI Agent allowance vault and micro-payment covenant on Bitcoin Cash.
 * @author Team AgentPay (BCH BLAZE 2026 Hackathon)
 */
contract AgentVault(
    pubkey ownerPk,         // Human vault owner (sole sovereign reclaim authority)
    pubkey agentPk,         // AI Agent session key (limited autonomous spending authority)
    int maxPerTx            // Hard ceiling for a single expenditure in satoshis (e.g. 5000 sats)
) {
    /**
     * @notice Allows the AI Agent to execute an autonomous micro-payment to a service provider.
     * @param agentSig Cryptographic signature from the AI Agent key
     * @param amount The payment amount in satoshis to deliver to the service provider
     * @param serviceLockingBytecode The locking bytecode (scriptPubKey) of the service provider
     * @param minerFee Standard miner fee for the transaction (300 - 500 satoshis)
     */
    function spend(
        sig agentSig,
        int amount,
        bytes serviceLockingBytecode,
        int minerFee
    ) {
        // 1. Signature check: Prove authorization by the AI Agent
        require(checkSig(agentSig, agentPk));

        // 2. Spending limit check: Amount cannot exceed the owner's hard cap
        require(amount <= maxPerTx);

        // 3. Dust threshold check: Protect against non-standard output rejection (< 546 sats)
        require(amount >= 546);

        // 4. Output 0 enforcement: Ensure Output 0 goes directly to the verified service provider
        require(tx.outputs[0].value == amount);
        require(tx.outputs[0].lockingBytecode == serviceLockingBytecode);

        // 5. Recursive Covenant Introspection:
        // Calculate remaining change after deducting the payment and miner fee
        int change = tx.inputs[this.activeInputIndex].value - amount - minerFee;

        // If change exceeds dust threshold, enforce that Output 1 must return to this exact contract
        if (change >= 546) {
            require(tx.outputs[1].value == change);
            // CRITICAL: Introspection opcode comparison guarantees recursive state preservation
            require(tx.outputs[1].lockingBytecode == tx.inputs[this.activeInputIndex].lockingBytecode);
        }
    }

    /**
     * @notice Allows the human vault owner to unconditionally reclaim and sweep 100% of remaining funds.
     * @param ownerSig Cryptographic signature from the human master key
     */
    function reclaim(sig ownerSig) {
        require(checkSig(ownerSig, ownerPk));
    }
}
